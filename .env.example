# Site login (required) — shown when you open the app
SITE_AUTH_USERNAME=your_username
SITE_AUTH_PASSWORD=your_password
SITE_AUTH_SECRET=random_long_secret_string

DURIAN_USERNAME=your_username_here
DURIAN_API_KEY=your_api_key_here

# Required for real service names (Microsoft, Amazon, etc.) from the DurianRCS web panel:
# Option A — run once: npm run panel-login (needs DURIAN_WEB_PASSWORD below)
DURIAN_WEB_PASSWORD=your_web_panel_password

# Option B — copy from browser DevTools → Application → Cookies → PHPSESSID
# DURIAN_SESSION_COOKIE=PHPSESSID=your_session_id_here

# After signing into this app, open /panel-refresh on your phone to renew the panel without a PC.
# On Render, prefer that saved session over a stale env cookie:
# DURIAN_USE_DISK_PANEL_COOKIE=1

# Auto-sync new Durian services (FIX-AND-START.bat + while site runs)
# DURIAN_AUTO_SYNC_MINUTES=30
# DURIAN_SYNC_MAX_AGE_HOURS=12
# DURIAN_AUTO_SYNC_DISABLED=1

# Cloud deploy — cron / external ping (optional; see DEPLOY.md)
# CRON_SECRET=long_random_string_for_sync_endpoint

# Panel catalog fetch (production defaults to sequential to avoid 503)
# DURIAN_PANEL_FETCH_MODE=sequential
# DURIAN_PANEL_FETCH_CONCURRENCY=3
# DURIAN_PANEL_FETCH_DELAY_MS=120
